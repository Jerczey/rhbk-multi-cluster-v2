# Copy to secrets/postgres.env and adjust if needed
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=KeycloakPoC2026! # notsecret
POSTGRES_DB=keycloak
REPLICATION_USER=replicator
REPLICATION_PASSWORD=ReplicatorPoC2026! # notsecret
PRIMARY_HOST=192.168.0.114
PRIMARY_PORT=5432
# Must match PG_VERSION in postgres/primary/data (pg_upgrade required to move major versions).
POSTGRES_IMAGE=registry.access.redhat.com/hi/postgresql:17
