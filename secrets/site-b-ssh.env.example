# Copy to secrets/site-b-ssh.env (gitignored) — password SSH to Windows Site B from Linux.
# Lab only; do not commit secrets/site-b-ssh.env.
SITE_B_SSH_HOST=192.168.0.102
SITE_B_SSH_USER=sitea-ssh
SITE_B_SSH_PASSWORD=your-windows-password-here
# OpenShift namespace and Keycloak workload on Windows CRC
SITE_B_OC_NAMESPACE=rhbk-mc
# StatefulSet created by Keycloak operator (usually matches Keycloak CR name)
SITE_B_KEYCLOAK_STS=keycloak-b
# Optional Windows CRC paths (defaults match setup-sitea-ssh-oc-path.ps1)
# SITE_B_OC_BIN=C:\ProgramData\crc\bin\oc.exe
# SITE_B_KUBECONFIG=C:\ProgramData\crc\kubeconfig
