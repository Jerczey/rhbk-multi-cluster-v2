{
  "client": {
    "clientId": "poc-spa",
    "name": "Multi-cluster PoC SPA",
    "enabled": true,
    "publicClient": true,
    "directAccessGrantsEnabled": true,
    "standardFlowEnabled": true,
    "redirectUris": [
      "http://localhost:8080/*",
      "http://127.0.0.1:8080/*",
      "https://auth.lan.local:8444/*"
    ],
    "webOrigins": [
      "http://localhost:8080",
      "http://127.0.0.1:8080",
      "https://auth.lan.local:8444"
    ],
    "attributes": {
      "pkce.code.challenge.method": "S256"
    }
  },
  "additionalClients": [
    {
      "clientId": "poc-load",
      "name": "PoC Gatling load client",
      "enabled": true,
      "publicClient": false,
      "secret": "poc-load-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8080/*",
        "http://127.0.0.1:8080/*"
      ],
      "webOrigins": ["+"]
    },
    {
      "clientId": "poc-api",
      "name": "PoC protected API",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "protocol": "openid-connect"
    }
  ],
  "roles": [
    { "name": "user", "description": "User privileges" },
    { "name": "admin", "description": "Administrator privileges" }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "email": "alice@example.com",
      "firstName": "Alice",
      "lastName": "Liddel",
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "alice", "temporary": false }],
      "realmRoles": ["user"]
    },
    {
      "username": "bob",
      "enabled": true,
      "email": "bob@example.com",
      "firstName": "Bob",
      "lastName": "Builder",
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "bob", "temporary": false }],
      "realmRoles": ["user"]
    }
  ]
}
